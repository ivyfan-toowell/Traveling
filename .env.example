# ============================================
# 复制本文件为 .env，并填入真实值。切勿将 .env 提交到版本库。
# cp .env.example .env
# ============================================

# ===== LLM（阿里云 DashScope / 通义千问）=====
DASHSCOPE_API_KEY=
QWEN_MODEL_NAME=
QWEN_BASE_URL=

# ===== LangSmith 可观测性 =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=

# ===== PostgreSQL（Checkpointer / Store）=====
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ===== Redis（缓存）=====
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 高德地图 API（天气与地图）=====
AMAP_API_KEY=

# ===== Tavily 搜索 API =====
TAVILY_API_KEY=

# ===== Variflight 航班 API =====
VARIFLIGHT_API_KEY=

# ===== AIGOHOTEL 酒店获取 API =====
AIGOHOTEL_MCP_API=

# ===== 应用配置 =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=14726
DEBUG=true
JWT_SECRET_KEY=
CORS_ORIGINS=*