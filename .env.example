# 复制为 .env 后填写密钥；.env 不会提交到 GitHub。
# Docker Compose 使用内置 PostgreSQL / Redis；下面主机地址用于本地 Python 启动。

# 必填：用于聊天、查询优化、重排序及 text-embedding-v2 向量生成。
DASHSCOPE_API_KEY=
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：默认关闭追踪，不需要 LangSmith 账号。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-planner-dev
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_user
# 必填：自行设置数据库密码，不要上传真实密码。
POSTGRES_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 内置 Compose Redis 无密码，仅向本机开放端口。
REDIS_PASSWORD=

# 按需填写：缺少密钥或外部服务不可用时，对应实时查询功能受限。
AMAP_API_KEY=
TAVILY_API_KEY=
VARIFLIGHT_API_KEY=
AIGOHOTEL_MCP_API=

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=14726
DEBUG=false
# 建议生成独立随机密钥，见 README。
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:14726,http://127.0.0.1:14726
